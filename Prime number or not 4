#include <stdio.h>

int main() {
    int n, i, isPrime = 1;

    if (scanf("%d", &n) != 1) return 0;

    if (n <= 1) {
        isPrime = 0;
    } else {
        
        for (i = 2; i <= n / 2; i++) {
            if (n % i == 0) {
                isPrime = 0; 
                break;
            }
        }
    }

   
    if (isPrime) {
        printf("Prime Number\n");
    } else {
        printf("Not Prime Number\n");
    }

    return 0;
}
