#include <stdio.h>
#include <math.h>

int main() {
    long long binary;
    int decimal = 0, i = 0, remainder;

    if (scanf("%lld", &binary) != 1) {
        return 0;
    }

    while (binary != 0) {
        remainder = binary % 10;    
        binary /= 10;               
        decimal += remainder * pow(2, i);
        ++i;
    }

    printf("%d\n", decimal);

    return 0;
}
