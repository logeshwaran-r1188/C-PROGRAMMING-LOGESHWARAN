#include <stdio.h>

int main() {
    int n, octalNum[32];
    int i = 0;

    if (scanf("%d", &n) != 1) {
        return 0;
    }

    if (n == 0) {
        printf("0");
        return 0;
    }

    while (n > 0) {
        octalNum[i] = n % 8; 
        n = n / 8;          
        i++;
    }

    for (int j = i - 1; j >= 0; j--) {
        printf("%d", octalNum[j]);
    }

    return 0;
}
