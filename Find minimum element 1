#include <stdio.h>

int main() {
    int n, min;
 if (scanf("%d", &n) != 1) return 0;

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);

        
        if (i == 0) {
            min = arr[0];
        } else {
           
            if (arr[i] < min) {
                min = arr[i];
            }
        }
    }
printf("%d", min);

    return 0;
}
