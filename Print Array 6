#include <stdio.h>

int main() {
    int n;

    if (scanf("%d", &n) != 1) return 0;

    if (n < 1 || n > 20) return 0;

    int arr[n];

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < n; i++) {
        printf("%d", arr[i]);

        if (i < n - 1) {
            printf(" ");
        }
    }

    return 0;
}
