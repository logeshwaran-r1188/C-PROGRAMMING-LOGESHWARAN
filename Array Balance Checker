#include <stdio.h>

int main() {
    int N;

    if (scanf("%d", &N) != 1) return 0;

    int arr[N];
    int leftSum = 0;
    int rightSum = 0;

    for (int i = 0; i < N; i++) {
        scanf("%d", &arr[i]);
    }

    for (int i = 0; i < N / 2; i++) {
        leftSum += arr[i];
    }

    for (int i = N / 2; i < N; i++) {
        rightSum += arr[i];
    }

    if (leftSum == rightSum) {
        printf("BALANCED\n");
    } else {
        printf("NOT BALANCED\n");
    }

    return 0;
}
